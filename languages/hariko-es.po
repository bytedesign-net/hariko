#. Theme Name of the theme
#: style.css
msgid "Hariko"
msgstr "Hariko"

#. Theme URI of the theme
#: style.css
msgid "https://hariko.bytedesign.net/"
msgstr "https://hariko.bytedesign.net/"

#. Description of the theme
#: style.css
msgid "Hariko is a minimalist WordPress block theme designed for flexibility and customization. It includes preset colors, typography, content and wide layout sizes, reusable template parts, and standard, full-width, and sidebar templates for pages and posts. All theme text is translatable through the `hariko` text domain, and translations into Japanese, Simplified and Traditional Chinese, Korean, Spanish, French, German and Italian are bundled in the download."
msgstr "Hariko es un tema de bloques de WordPress minimalista diseñado para la flexibilidad y la personalización. Incluye colores predefinidos, tipografías, tamaños de contenido y de diseño ancho, partes de plantilla reutilizables y plantillas estándar, a ancho completo y con barra lateral para páginas y entradas. Todo el texto del tema puede traducirse a través del dominio de texto `hariko`; la descarga incluye traducciones al japonés, chino simplificado y tradicional, coreano, español, francés, alemán e italiano."

#. Author of the theme
#: style.css
msgid "BYTE DESIGN"
msgstr "BYTE DESIGN"

