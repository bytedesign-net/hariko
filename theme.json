{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "viewport": {
      "mobile": "480px",
      "tablet": "782px"
    },
    "color": {
      "custom": true,
      "customGradient": true,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#e8f1fe",
          "name": "Base",
          "slug": "base"
        },
        {
          "color": "#ffffff",
          "name": "Base / Two",
          "slug": "base-2"
        },
        {
          "color": "#1a1a1a",
          "name": "Contrast",
          "slug": "contrast"
        },
        {
          "color": "#0066b3",
          "name": "Primary",
          "slug": "primary"
        },
        {
          "color": "#0074f5",
          "name": "Secondary (accent only)",
          "slug": "secondary"
        },
        {
          "color": "#00428c",
          "name": "Tertiary",
          "slug": "tertiary"
        },
        {
          "color": "#e6e6e6",
          "name": "Light Gray",
          "slug": "light-gray"
        },
        {
          "color": "#595959",
          "name": "Gray",
          "slug": "gray"
        },
        {
          "color": "#4d4d4d",
          "name": "Dark Gray",
          "slug": "dark-gray"
        }
      ]
    },
    "layout": {
      "contentSize": "980px",
      "wideSize": "1180px",
      "allowEditing": true
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "XS",
          "size": "4px",
          "slug": "xs"
        },
        {
          "name": "S",
          "size": "8px",
          "slug": "s"
        },
        {
          "name": "M",
          "size": "16px",
          "slug": "m"
        },
        {
          "name": "L",
          "size": "24px",
          "slug": "l"
        },
        {
          "name": "XL",
          "size": "40px",
          "slug": "xl"
        },
        {
          "name": "2XL",
          "size": "64px",
          "slug": "2-xl"
        },
        {
          "name": "3XL",
          "size": "104px",
          "slug": "3-xl"
        }
      ],
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontSizes": [
        {
          "fluid": false,
          "name": "XS",
          "size": "12px",
          "slug": "xs"
        },
        {
          "fluid": false,
          "name": "S",
          "size": "14px",
          "slug": "s"
        },
        {
          "fluid": false,
          "name": "M",
          "size": "16px",
          "slug": "m"
        },
        {
          "fluid": {
            "max": "20px",
            "min": "18px"
          },
          "name": "L",
          "size": "20px",
          "slug": "l"
        },
        {
          "fluid": {
            "max": "24px",
            "min": "22px"
          },
          "name": "XL",
          "size": "24px",
          "slug": "xl"
        },
        {
          "fluid": {
            "max": "28px",
            "min": "26px"
          },
          "name": "2XL",
          "size": "28px",
          "slug": "2-xl"
        },
        {
          "fluid": {
            "max": "32px",
            "min": "30px"
          },
          "name": "3XL",
          "size": "32px",
          "slug": "3-xl"
        },
        {
          "fluid": {
            "max": "36px",
            "min": "34px"
          },
          "name": "4XL",
          "size": "36px",
          "slug": "4-xl"
        },
        {
          "fluid": {
            "max": "45px",
            "min": "42px"
          },
          "name": "5XL",
          "size": "45px",
          "slug": "5-xl"
        },
        {
          "fluid": {
            "max": "57px",
            "min": "54px"
          },
          "name": "6XL",
          "size": "57px",
          "slug": "6-xl"
        }
      ],
      "fontFamilies": [
        {
          "fontFamily": "sans-serif",
          "name": "Default",
          "slug": "body"
        },
        {
          "fontFamily": "sans-serif",
          "name": "Sans serif",
          "slug": "sans-serif"
        },
        {
          "fontFamily": "serif",
          "name": "Serif",
          "slug": "serif"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "css": "/* Backward compatibility for size slugs used in Hariko before 1.0.13. */\n:root {\n  --wp--preset--font-size--xxl: var(--wp--preset--font-size--2-xl);\n  --wp--preset--font-size--xxxl: var(--wp--preset--font-size--3-xl);\n  --wp--preset--font-size--xxxxl: var(--wp--preset--font-size--4-xl);\n  --wp--preset--font-size--xxxxxl: var(--wp--preset--font-size--5-xl);\n  --wp--preset--font-size--xxxxxxl: var(--wp--preset--font-size--6-xl);\n  --wp--preset--spacing--xxl: var(--wp--preset--spacing--2-xl);\n  --wp--preset--spacing--xxxl: var(--wp--preset--spacing--3-xl);\n}\n.has-xxl-font-size {\n  font-size: var(--wp--preset--font-size--2-xl) !important;\n}\n.has-xxxl-font-size {\n  font-size: var(--wp--preset--font-size--3-xl) !important;\n}\n.has-xxxxl-font-size {\n  font-size: var(--wp--preset--font-size--4-xl) !important;\n}\n.has-xxxxxl-font-size {\n  font-size: var(--wp--preset--font-size--5-xl) !important;\n}\n.has-xxxxxxl-font-size {\n  font-size: var(--wp--preset--font-size--6-xl) !important;\n}",
    "blocks": {
      "core/accordion": {
        "typography": {
          "fontWeight": "700"
        }
      },
      "core/accordion-item": {
        "border": {
          "bottom": {
            "color": "var:preset|color|light-gray",
            "width": "1px",
            "style": "solid"
          }
        }
      },
      "core/accordion-heading": {
        "css": "&:hover { color: var(--wp--preset--color--tertiary); } &:focus-within { color: var(--wp--preset--color--tertiary); } & .wp-block-accordion-heading__toggle { padding: var(--wp--preset--spacing--m) 0; }"
      },
      "core/accordion-panel": {
        "typography": {
          "fontWeight": "400"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--primary)"
            }
          }
        }
      },
      "core/query-pagination-numbers": {
        "color": {
          "text": "var(--wp--preset--color--dark-gray)"
        }
      },
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "var(--wp--preset--color--primary)"
            },
            "color": {
              "text": "var(--wp--preset--color--primary)"
            }
          }
        }
      },
      "core/navigation-link": {
        "@mobile": {
          "typography": {
            "fontSize": "var(--wp--preset--font-size--s)"
          }
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--tertiary)"
          }
        },
        ":focus": {
          "color": {
            "text": "var(--wp--preset--color--tertiary)"
          }
        },
        ":focus-visible": {
          "color": {
            "text": "var(--wp--preset--color--tertiary)"
          }
        },
        "-current": {
          "color": {
            "text": "var(--wp--preset--color--primary)"
          },
          "typography": {
            "fontWeight": "700"
          },
          ":hover": {
            "color": {
              "text": "var(--wp--preset--color--tertiary)"
            }
          }
        }
      }
    },
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "elements": {
      "button": {
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--tertiary)",
            "text": "var(--wp--preset--color--base-2)"
          }
        },
        ":focus": {
          "color": {
            "background": "var(--wp--preset--color--tertiary)",
            "text": "var(--wp--preset--color--base-2)"
          }
        },
        ":focus-visible": {
          "color": {
            "background": "var(--wp--preset--color--tertiary)",
            "text": "var(--wp--preset--color--base-2)"
          }
        },
        ":active": {
          "color": {
            "background": "var(--wp--preset--color--contrast)",
            "text": "var(--wp--preset--color--base-2)"
          }
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--base-2)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans-serif)",
          "fontStyle": "normal",
          "fontWeight": "700"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--4-xl)",
          "fontStyle": "normal",
          "lineHeight": "1.4"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3-xl)",
          "lineHeight": "1.5"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2-xl)",
          "fontStyle": "normal",
          "lineHeight": "1.5"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)",
          "lineHeight": "1.5"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--l)",
          "fontStyle": "normal",
          "lineHeight": "1.5"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--m)",
          "fontStyle": "normal",
          "lineHeight": "1.7"
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        },
        "spacing": {
          "margin": {
            "top": "1.5rem",
            "bottom": "0"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans-serif)",
          "fontWeight": "700",
          "lineHeight": "1.7"
        }
      },
      "link": {
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--tertiary)"
          }
        },
        ":focus": {
          "color": {
            "text": "var(--wp--preset--color--tertiary)"
          }
        },
        ":focus-visible": {
          "color": {
            "text": "var(--wp--preset--color--tertiary)"
          }
        },
        ":active": {
          "color": {
            "text": "var(--wp--preset--color--contrast)"
          }
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "textDecoration": "underline"
        }
      }
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0",
        "left": "var(--wp--preset--spacing--m)",
        "right": "var(--wp--preset--spacing--m)",
        "bottom": "0"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans-serif)",
      "fontSize": "var(--wp--preset--font-size--m)",
      "fontStyle": "normal",
      "fontWeight": "400",
      "lineHeight": "1.7"
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    },
    {
      "area": "uncategorized",
      "name": "posts",
      "title": "Posts"
    },
    {
      "area": "uncategorized",
      "name": "sidebar",
      "title": "Sidebar"
    }
  ],
  "customTemplates": [
    {
      "name": "single-with-sidebar",
      "postTypes": [
        "post"
      ],
      "title": "Single with sidebar"
    },
    {
      "name": "single-fullwidth",
      "postTypes": [
        "post"
      ],
      "title": "Single fullwidth"
    },
    {
      "name": "page-with-sidebar",
      "postTypes": [
        "page"
      ],
      "title": "Page with sidebar"
    },
    {
      "name": "page-fullwidth",
      "postTypes": [
        "page"
      ],
      "title": "Page fullwidth"
    }
  ]
}
